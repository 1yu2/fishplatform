---
import { Image } from 'astro:assets';
import { languages, localePath, useTranslations, type Lang } from '../i18n/utils';
import Nav from './Nav.astro';
import NowStrip from './now/NowStrip.astro';
import { formatDate, getPosts, postPath } from '../lib/posts';
import { getProjects, projectPath, projectsFor } from '../lib/projects';
import { SITE } from '../site';

interface Props { lang: Lang; alternates: Record<Lang, string>; }
const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts();
const filePosts = posts.length;
const latestPosts = posts.slice(0, 2);
const featuredProjects = projectsFor(await getProjects(), lang).slice(0, 2);
---
<canvas id="scene" aria-hidden="true"></canvas>

<div id="intro"><canvas id="intro-gl" aria-hidden="true"></canvas><button class="intro-skip" type="button">{t('intro.enter')}</button></div>

<Nav lang={lang} current="home" alternates={alternates} />

<main id="top" class="wrap">

  <section class="hero" aria-label="Intro">
    <div class="hero-orbit" aria-hidden="true"><i></i><i></i></div>
    <div class="hero-copy">
      <div class="hero-role"><span></span>{t('home.hero.role')}</div>
      <div class="eyebrow">{t('home.hero.eyebrow')}</div>
      <h1>
        <span class="title-main">{t('home.hero.titleMain')}</span>
        <span class="title-accent">{t('home.hero.titleAccent')}</span>
      </h1>
      <div class="hero-intro">
        <p class="lead">{t('home.hero.lead')}</p>
        <div class="cta-group">
          <a class="btn btn-solid" href={localePath(lang, '/projects/')}>{t('home.hero.cta1')}<span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href={localePath(lang, '/blog/')}>{t('home.hero.cta2')}</a>
        </div>
      </div>
    </div>
    <div class="hero-signature" aria-hidden="true"><span>{SITE.name}</span><i></i><span>2026</span></div>
    <div class="foot">
      <p>{t('home.hero.foot')}</p>
      <span class="scroll-cue"><span class="bar"></span>{t('home.hero.scroll')}</span>
    </div>
  </section>

  <section id="about" class="about" aria-label="Studio">
    <div class="eyebrow reveal">{t('home.studio.eyebrow')}</div>
    <h2 class="reveal">{t('home.studio.title')}</h2>
    <p class="lead reveal">{t('home.studio.lead')}</p>
    <div class="stats">
      <a class="stat reveal" href={localePath(lang, '/blog/')}><div class="n" data-stat="posts" data-base={filePosts}>{filePosts}</div><div class="l">{t('home.stat1')}</div></a>
      <a class="stat reveal" href={localePath(lang, '/learning/')}><div class="n" data-stat="learning">–</div><div class="l">{t('home.stat2')}</div></a>
      <div class="stat reveal"><div class="n" data-stat="done">–</div><div class="l">{t('home.stat3')}</div></div>
    </div>
  </section>

  <section id="services" class="services" aria-label="Explore">
    <div class="section-head">
      <div>
        <div class="eyebrow reveal">{t('home.svc.eyebrow')}</div>
        <h2 class="reveal">{t('home.svc.title')}</h2>
      </div>
      <p class="reveal">{t('home.svc.lead')}</p>
    </div>
    <div class="cards">
      <article class="card reveal">
        <span class="idx">01</span>
        <div class="glyph" data-shape="ring" aria-hidden="true">
          <svg viewBox="0 0 100 100" fill="none">
            <circle cx="50" cy="50" r="34" stroke="url(#g1)" stroke-width="6" stroke-linecap="round" stroke-dasharray="150 60"/>
            <defs><linearGradient id="g1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9b6bff"/><stop offset="1" stop-color="#4a28b8"/></linearGradient></defs>
          </svg>
        </div>
        <h3>{t('home.card1.title')}</h3>
        <p>{t('home.card1.body')}</p>
        <a class="card-link" href={localePath(lang, '/blog/')}><span>{t('home.cardMore')}</span></a>
      </article>
      <article class="card reveal">
        <span class="idx">02</span>
        <div class="glyph" data-shape="triangle" aria-hidden="true">
          <svg viewBox="0 0 100 100" fill="none">
            <polygon points="50,18 82,74 18,74" stroke="url(#g2)" stroke-width="6" stroke-linejoin="round"/>
            <defs><linearGradient id="g2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9b6bff"/><stop offset="1" stop-color="#4a28b8"/></linearGradient></defs>
          </svg>
        </div>
        <h3>{t('home.card2.title')}</h3>
        <p>{t('home.card2.body')}</p>
        <a class="card-link" href={localePath(lang, '/learning/')}><span>{t('home.cardMore')}</span></a>
      </article>
      <article class="card reveal">
        <span class="idx">03</span>
        <div class="glyph" data-shape="diamond" aria-hidden="true">
          <svg viewBox="0 0 100 100" fill="none">
            <rect x="29" y="29" width="42" height="42" rx="6" transform="rotate(45 50 50)" stroke="url(#g3)" stroke-width="6" stroke-linejoin="round"/>
            <defs><linearGradient id="g3" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9b6bff"/><stop offset="1" stop-color="#4a28b8"/></linearGradient></defs>
          </svg>
        </div>
        <h3>{t('home.card3.title')}</h3>
        <p>{t('home.card3.body')}</p>
        <a class="card-link" href={localePath(lang, '/projects/')}><span>{t('home.cardMore')}</span></a>
      </article>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section id="work" class="work" aria-labelledby="work-title">
      <div class="section-head">
        <div>
          <div class="eyebrow reveal">{t('home.work.eyebrow')}</div>
          <h2 id="work-title" class="reveal">{t('home.work.title')}</h2>
        </div>
        <a class="text-link reveal" href={localePath(lang, '/projects/')}>{t('home.work.all')}</a>
      </div>
      <div class="work-grid">
        {featuredProjects.map((p, index) => (
          <article class="work-card reveal">
            <a href={projectPath(p)}>
              {p.data.cover ? (
                <Image class="work-cover" src={p.data.cover} alt="" widths={[560, 1120]} sizes="(max-width: 760px) 100vw, 560px" />
              ) : (
                <div class:list={['work-art', `art-${index + 1}`]} aria-hidden="true">
                  <span class="art-index">0{index + 1}</span>
                  <div class="art-browser"><div class="browser-bar"><i></i><i></i><i></i></div><div class="browser-body"><b></b><b></b><b></b></div></div>
                  <div class="art-orbit"><i></i><i></i><b></b><em></em></div>
                  <div class="art-nodes"><i></i><i></i><i></i><b></b><em></em></div>
                </div>
              )}
              <div class="work-body">
                <div class="work-meta">
                  <span class={`work-status st-${p.data.status}`}><i></i>{t(`projects.status.${p.data.status}`)}</span>
                  {p.data.lang !== lang && <span class="lang-badge">{languages[p.data.lang]}</span>}
                </div>
                <h3 lang={p.data.lang}>{p.data.title}</h3>
                <p lang={p.data.lang}>{p.data.summary}</p>
                {p.data.impact && <p class="work-impact" lang={p.data.lang}>{p.data.impact}</p>}
                <div class="work-stack">{p.data.stack.slice(0, 4).map((item) => <span class="tag">{item}</span>)}</div>
                <span class="work-more">{t('projects.more')}<span aria-hidden="true">↗</span></span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  {latestPosts.length > 0 && (
    <section id="journal" class="journal" aria-labelledby="journal-title">
      <div class="section-head">
        <div>
          <div class="eyebrow reveal">{t('home.journal.eyebrow')}</div>
          <h2 id="journal-title" class="reveal">{t('home.journal.title')}</h2>
        </div>
        <a class="text-link reveal" href={localePath(lang, '/blog/')}>{t('home.journal.all')}</a>
      </div>
      <div class="journal-list">
        {latestPosts.map((p, index) => (
          <article class="journal-item reveal">
            <a href={postPath(p)}>
              <span class="journal-index" aria-hidden="true">0{index + 1}</span>
              <div class="journal-meta">
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang)}</time>
                {p.data.lang !== lang && <span class="lang-badge">{languages[p.data.lang]}</span>}
              </div>
              <h3 lang={p.data.lang}>{p.data.title}</h3>
              <p lang={p.data.lang}>{p.data.summary}</p>
              <div class="journal-foot">
                <div class="journal-tags">{p.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}</div>
                <span class="journal-arrow" aria-hidden="true">↗</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  <section id="now" aria-label="Now">
    <NowStrip lang={lang} />
  </section>

  <section id="contact" class="foot-cta" aria-label="Contact">
    <div class="eyebrow reveal">{t('home.contact.eyebrow')}</div>
    <h2 class="reveal">{t('home.contact.title')}</h2>
    <p class="contact-lead reveal">{t('contact.lead')}</p>
    <div class="cta-group contact-actions reveal">
      <a class="btn btn-solid" href={SITE.github} target="_blank" rel="noopener noreferrer">{t('contact.github')}<span aria-hidden="true">↗</span></a>
      <a class="btn btn-ghost" href={localePath(lang, '/projects/')}>{t('contact.projects')}</a>
    </div>
    <footer class="end">
      <span>© 2026 {SITE.name}</span>
      <span>{t('home.footer.tagline')}</span>
    </footer>
  </section>

</main>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script is:inline>
(function(){
  "use strict";
  document.documentElement.classList.add('js');
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- reveal on scroll ---------- */
  var revs = [].slice.call(document.querySelectorAll('.reveal'));
  if('IntersectionObserver' in window && !reduce){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    },{threshold:.15, rootMargin:'0px 0px -8% 0px'});
    revs.forEach(function(el){ io.observe(el); });
    setTimeout(function(){ revs.forEach(function(el){ el.classList.add('in'); }); }, 2500); // safety: never stuck hidden
  } else {
    revs.forEach(function(el){ el.classList.add('in'); });
  }

  /* ---------- hide the scroll hint once the user scrolls ---------- */
  function markScrolled(){ document.documentElement.classList.toggle('scrolled', window.scrollY > 40); }
  window.addEventListener('scroll', markScrolled, {passive:true});
  markScrolled();

  /* ---------- WebGL particle sphere ---------- */
  var canvas = document.getElementById('scene');
  var THREE = window.THREE;
  if(!THREE){ canvas.style.display='none'; document.documentElement.classList.remove('intro-on'); return; }

  function tok(name, fallback){ return getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback; }
  function rgba(hex, a){ var c = new THREE.Color(hex); return 'rgba('+Math.round(c.r*255)+','+Math.round(c.g*255)+','+Math.round(c.b*255)+','+a+')'; }
  function smooth(e0, e1, x){ var k = Math.min(Math.max((x-e0)/(e1-e0),0),1); return k*k*(3-2*k); }

  initIntro();
  initGlyphs();

  var renderer;
  try{
    renderer = new THREE.WebGLRenderer({canvas:canvas, alpha:true, antialias:true, powerPreference:'high-performance'});
  }catch(err){ canvas.style.display='none'; return; }
  renderer.setClearColor(0x000000, 0);

  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
  camera.position.z = 5.2;

  var group = new THREE.Group();
  scene.add(group);

  // shared GLSL simplex noise
  var SNOISE = [
    "vec4 permute(vec4 x){return mod(((x*34.0)+1.0)*x,289.0);}",
    "vec4 taylorInvSqrt(vec4 r){return 1.79284291400159 - 0.85373472095314 * r;}",
    "float snoise(vec3 v){",
    "  const vec2 C = vec2(1.0/6.0, 1.0/3.0); const vec4 D = vec4(0.0,0.5,1.0,2.0);",
    "  vec3 i = floor(v + dot(v, C.yyy)); vec3 x0 = v - i + dot(i, C.xxx);",
    "  vec3 g = step(x0.yzx, x0.xyz); vec3 l = 1.0 - g;",
    "  vec3 i1 = min(g.xyz, l.zxy); vec3 i2 = max(g.xyz, l.zxy);",
    "  vec3 x1 = x0 - i1 + C.xxx; vec3 x2 = x0 - i2 + C.yyy; vec3 x3 = x0 - D.yyy;",
    "  i = mod(i,289.0);",
    "  vec4 p = permute(permute(permute(i.z+vec4(0.0,i1.z,i2.z,1.0))+i.y+vec4(0.0,i1.y,i2.y,1.0))+i.x+vec4(0.0,i1.x,i2.x,1.0));",
    "  float n_=0.142857142857; vec3 ns = n_*D.wyz - D.xzx;",
    "  vec4 j = p - 49.0*floor(p*ns.z*ns.z);",
    "  vec4 x_=floor(j*ns.z); vec4 y_=floor(j-7.0*x_);",
    "  vec4 x=x_*ns.x+ns.yyyy; vec4 y=y_*ns.x+ns.yyyy; vec4 h=1.0-abs(x)-abs(y);",
    "  vec4 b0=vec4(x.xy,y.xy); vec4 b1=vec4(x.zw,y.zw);",
    "  vec4 s0=floor(b0)*2.0+1.0; vec4 s1=floor(b1)*2.0+1.0; vec4 sh=-step(h,vec4(0.0));",
    "  vec4 a0=b0.xzyw+s0.xzyw*sh.xxyy; vec4 a1=b1.xzyw+s1.xzyw*sh.zzww;",
    "  vec3 p0=vec3(a0.xy,h.x); vec3 p1=vec3(a0.zw,h.y); vec3 p2=vec3(a1.xy,h.z); vec3 p3=vec3(a1.zw,h.w);",
    "  vec4 norm=taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));",
    "  p0*=norm.x; p1*=norm.y; p2*=norm.z; p3*=norm.w;",
    "  vec4 m=max(0.6-vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)),0.0); m=m*m;",
    "  return 42.0*dot(m*m, vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));",
    "}"
  ].join("\n");

  var DISP = [
    "float dispFn(vec3 dir, float t){",
    "  float n = snoise(dir*1.25 + vec3(0.0,0.0,t*0.12));",
    "  float n2 = snoise(dir*3.1 + vec3(t*0.17));",
    "  return n*0.5 + n2*0.17;",
    "}"
  ].join("\n");

  // sphere -> hexagonal ring morph (second screen). Ring faces the camera (xy plane), pointy-top:
  // an outer band dense at the hexagon rim, plus (~28% of points) a darker inner ring around the hollow centre.
  var MORPH = [
    "uniform float uMorph,uSpin,uHexRot;",
    "vec3 rotY(vec3 p,float a){ float c=cos(a), s=sin(a); return vec3(c*p.x+s*p.z, p.y, -s*p.x+c*p.z); }",
    "vec3 hexPos(vec3 sp, vec2 seed, float d, float amp){",
    "  float th = atan(sp.y, sp.x);",
    "  float a = mod(th + 0.5235988, 1.0471976) - 0.5235988;",   // angle from nearest edge normal
    "  float rim = 1.98*0.8660254/cos(a);",                       // hexagon, circumradius 1.98
    "  float inner = step(0.72, seed.x);",
    "  float u = seed.x/0.72, v = (seed.x-0.72)/0.28;",
    "  float rOut = mix(rim, 1.22, u*u) + d*amp*0.3*(0.6+u);",    // band 1.22..rim, dense at the rim
    "  float rIn = 0.74 + (v-0.5)*0.24 + d*amp*0.25;",            // round inner ring, r ~0.62..0.86
    "  float r = mix(rOut, rIn, inner);",
    "  float z = mix((seed.y-0.5)*0.75*(1.0-0.5*u), (seed.y-0.5)*0.32, inner) + d*amp*0.4;",
    "  th += uHexRot;",
    "  return vec3(cos(th)*r, sin(th)*r, z);",
    "}",
    "float morphAt(float stagger){ return smoothstep(stagger*0.35, stagger*0.35+0.65, uMorph); }"
  ].join("\n");
  var morphU = { uMorph:{value:0}, uSpin:{value:0}, uHexRot:{value:0} };

  // ---- points cloud ----
  var N = 5200;
  var pos = new Float32Array(N*3);
  var scl = new Float32Array(N);
  var seeds = new Float32Array(N*2);
  var R = 1.72, GA = Math.PI*(3.0-Math.sqrt(5.0));
  for(var i=0;i<N;i++){
    var y = 1 - (i/(N-1))*2;
    var rad = Math.sqrt(1-y*y);
    var th = i*GA;
    var jitter = 0.86 + Math.random()*0.3;
    var rr = R*jitter;
    pos[i*3]   = Math.cos(th)*rad*rr;
    pos[i*3+1] = y*rr;
    pos[i*3+2] = Math.sin(th)*rad*rr;
    scl[i] = 0.5 + Math.random()*1.4;
    seeds[i*2] = Math.random(); seeds[i*2+1] = Math.random();
  }
  var pg = new THREE.BufferGeometry();
  pg.setAttribute('position', new THREE.BufferAttribute(pos,3));
  pg.setAttribute('aScale', new THREE.BufferAttribute(scl,1));
  pg.setAttribute('aSeed', new THREE.BufferAttribute(seeds,2));

  var uniforms = {
    uTime:{value:0}, uSize:{value:0.016}, uAmp:{value:0.30}, uPix:{value:1},
    uColor:{value:new THREE.Color(0x5a2cc2)}, uColor2:{value:new THREE.Color(0x9b6bff)},
    uMorph:morphU.uMorph, uSpin:morphU.uSpin, uHexRot:morphU.uHexRot
  };
  var pMat = new THREE.ShaderMaterial({
    uniforms:uniforms, transparent:true, depthWrite:false, depthTest:false,
    blending:THREE.NormalBlending,
    vertexShader:[
      "attribute float aScale;",
      "attribute vec2 aSeed;",
      "uniform float uTime,uSize,uAmp,uPix;",
      "varying float vGlow;",
      SNOISE, DISP, MORPH,
      "void main(){",
      "  vec3 dir = normalize(position);",
      "  float d = dispFn(dir,uTime);",
      "  vec3 sp = rotY(position,uSpin);",
      "  vec3 sphereP = sp + rotY(dir,uSpin)*d*uAmp;",
      "  float m = morphAt(aSeed.y);",
      "  vec3 p = mix(sphereP, hexPos(sp,aSeed,d,uAmp), m);",
      "  float inner = step(0.72, aSeed.x)*m;",
      "  vGlow = min(smoothstep(-0.15,0.6,d) + m*smoothstep(0.75,1.0,1.0-aSeed.x)*0.35, 1.0)*(1.0-inner);", // bright rim, deep inner ring
      "  vec4 mv = modelViewMatrix*vec4(p,1.0);",
      "  gl_Position = projectionMatrix*mv;",
      "  gl_PointSize = uSize*aScale*uPix*(1.0/-mv.z)*(1.0 + inner*0.7);",
      "}"
    ].join("\n"),
    fragmentShader:[
      "precision mediump float;",
      "uniform vec3 uColor,uColor2;",
      "varying float vGlow;",
      "void main(){",
      "  float d = length(gl_PointCoord-0.5);",
      "  if(d>0.5) discard;",
      "  float a = smoothstep(0.5,0.0,d);",
      "  vec3 col = mix(uColor,uColor2,vGlow);",
      "  gl_FragColor = vec4(col, a*(0.5+vGlow*0.45));",
      "}"
    ].join("\n")
  });
  var points = new THREE.Points(pg, pMat);
  group.add(points);

  // ---- wire mesh (the network) ----
  var ig = new THREE.IcosahedronGeometry(1.80, 3);
  var wUniforms = {
    uTime:{value:0}, uAmp:{value:0.30}, uColor:{value:new THREE.Color(0x7c4dff)}, uOpacity:{value:0.10},
    uMorph:morphU.uMorph, uSpin:morphU.uSpin, uHexRot:morphU.uHexRot
  };
  var wMat = new THREE.ShaderMaterial({
    uniforms:wUniforms, transparent:true, depthWrite:false, wireframe:true,
    blending:THREE.NormalBlending,
    vertexShader:[
      "uniform float uTime,uAmp;", "varying float vA;",
      SNOISE, DISP, MORPH,
      "void main(){",
      "  vec3 dir = normalize(position);",
      "  float d = dispFn(dir,uTime);",
      "  vec3 sp = rotY(position,uSpin);",
      // smooth (noise-based) seeds keep neighbouring vertices together -> a coherent web on the rim
      "  vec2 seed = clamp(vec2(snoise(dir*1.6)*0.6+0.45, snoise(dir*2.3+7.1)*0.5+0.5), 0.0, 1.0);",
      "  seed.x *= 0.7;",   // outer band only; the inner layer has its own ring below
      "  float m = morphAt(seed.y);",
      "  vec3 p = mix(sp + rotY(dir,uSpin)*d*uAmp, hexPos(sp,seed,d,uAmp), m);",
      // vertices near the view-axis poles fan out into spokes across the hole once flattened -> hide them
      "  vA = mix(1.0, smoothstep(0.25,0.6,length(sp.xy)/length(sp)), m);",
      "  gl_Position = projectionMatrix*modelViewMatrix*vec4(p,1.0);",
      "}"
    ].join("\n"),
    fragmentShader:[
      "precision mediump float;",
      "uniform vec3 uColor; uniform float uOpacity; varying float vA;",
      "void main(){ gl_FragColor = vec4(uColor,uOpacity*vA); }"
    ].join("\n")
  });
  var wire = new THREE.Mesh(ig, wMat);
  group.add(wire);

  // ---- inner ring web (second layer inside the hexagon, fades in with the morph) ----
  var iwU = { uTime:wUniforms.uTime, uAmp:wUniforms.uAmp, uHexRot:morphU.uHexRot,
              uColor:{value:new THREE.Color(tok('--accent-2','#5a2fd0'))}, uOpacity:{value:0} };
  var innerWire = new THREE.Mesh(new THREE.TorusGeometry(0.76, 0.17, 5, 40), new THREE.ShaderMaterial({
    uniforms:iwU, transparent:true, depthWrite:false, wireframe:true, blending:THREE.NormalBlending,
    vertexShader:[
      "uniform float uTime,uAmp,uHexRot;",
      SNOISE, DISP,
      "void main(){",
      "  float d = dispFn(normalize(position)*1.4, uTime);",
      "  vec3 p = position*(1.0 + d*uAmp*0.7);",
      "  float c = cos(uHexRot*-1.6), s = sin(uHexRot*-1.6);",   // counter-rotates against the hexagon
      "  p.xy = mat2(c,s,-s,c)*p.xy;",
      "  gl_Position = projectionMatrix*modelViewMatrix*vec4(p,1.0);",
      "}"
    ].join("\n"),
    fragmentShader:[
      "precision mediump float;",
      "uniform vec3 uColor; uniform float uOpacity;",
      "void main(){ gl_FragColor = vec4(uColor,uOpacity); }"
    ].join("\n")
  }));
  group.add(innerWire);

  // ---- core glow sprite ----
  var cc = document.createElement('canvas'); cc.width=cc.height=256;
  var cx = cc.getContext('2d');
  var grd = cx.createRadialGradient(128,128,0,128,128,128);
  grd.addColorStop(0,'rgba(150,110,250,0.55)');
  grd.addColorStop(0.3,'rgba(124,77,255,0.26)');
  grd.addColorStop(0.6,'rgba(124,77,255,0.10)');
  grd.addColorStop(1,'rgba(124,77,255,0)');
  cx.fillStyle=grd; cx.fillRect(0,0,256,256);
  var coreTex = new THREE.CanvasTexture(cc);
  var coreMat = new THREE.SpriteMaterial({map:coreTex, transparent:true, blending:THREE.NormalBlending, depthWrite:false, depthTest:false});
  var core = new THREE.Sprite(coreMat);
  core.scale.set(2.4,2.4,1);
  group.add(core);

  // ---- faint concentric rings behind the hexagon (fade in with the morph) ----
  var ringColor = new THREE.Color(tok('--accent','#7c4dff'));
  var rings = [];
  [2.55, 3.15, 3.9].forEach(function(r, k){
    var g = new THREE.BufferGeometry().setFromPoints(new THREE.Path().absarc(0,0,r,0,Math.PI*2).getPoints(160));
    var m = new THREE.LineBasicMaterial({color:ringColor, transparent:true, opacity:0, depthWrite:false});
    var l = new THREE.LineLoop(g, m);
    l.position.z = -0.4 - k*0.2;
    l.userData.base = 0.16 - k*0.04;
    group.add(l); rings.push(l);
  });

  // ---- resize ----
  function resize(){
    var w = window.innerWidth, h = window.innerHeight;
    var dpr = Math.min(window.devicePixelRatio||1, 2);
    renderer.setPixelRatio(dpr);
    renderer.setSize(w,h,false);
    camera.aspect = w/h; camera.updateProjectionMatrix();
    uniforms.uPix.value = dpr * (h/2); // keep point size stable across resolutions
    // shift sphere to the right on wide screens, center on narrow
    group.position.x = w>900 ? 1.15 : 0;
    baseScale = w>900 ? 1 : 0.8;
  }
  var baseScale = 1;
  resize();
  window.addEventListener('resize', resize);

  // ---- mouse parallax ----
  var tx=0, ty=0, mx=0, my=0;
  window.addEventListener('pointermove', function(e){
    tx = (e.clientX/window.innerWidth - 0.5);
    ty = (e.clientY/window.innerHeight - 0.5);
  }, {passive:true});

  // ---- scroll drive ----
  var scrollP = 0, morphTarget = 0, morph = 0, exitP = 0;
  function onScroll(){
    var vh = window.innerHeight;
    scrollP = Math.min(window.scrollY / (vh*1.6), 1); // 0..1 across hero->about
    // sphere -> hexagon: starts as the hero leaves, done by the time the about section is centred
    morphTarget = Math.min(Math.max((window.scrollY - vh*0.3)/(vh*0.6), 0), 1);
    // services panel slides over: the shape lifts, shrinks and fades behind it
    exitP = Math.min(Math.max((window.scrollY - vh*1.15)/(vh*0.75), 0), 1);
    canvas.style.opacity = (1 - exitP).toFixed(3);
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();

  // ---- loop ----
  var clock = new THREE.Clock();

  function tick(){
    requestAnimationFrame(tick);
    var dt = clock.getDelta();
    if(document.hidden) return;          // keep time sane, skip rendering while hidden
    var t = clock.elapsedTime;
    var tt = reduce ? 0 : t;
    uniforms.uTime.value = tt;
    wUniforms.uTime.value = tt;

    // morph eases toward the scroll target (smooths wheel steps); per-particle stagger lives in the shader
    morph = reduce ? morphTarget : morph + (morphTarget - morph)*Math.min(1, dt*4.5);
    morphU.uMorph.value = morph;
    if(exitP >= 1) return;               // fully covered by the services panel

    // amplitude grows a little with scroll (gentle "bloom" on the about section)
    var amp = 0.30 + scrollP*0.26 - morph*0.12;
    uniforms.uAmp.value = amp;
    wUniforms.uAmp.value = amp;
    wUniforms.uOpacity.value = 0.10 + scrollP*0.12 + morph*0.06;
    rings.forEach(function(l){ l.material.opacity = l.userData.base*morph; });
    var im = smooth(0.45, 1, morph);
    iwU.uOpacity.value = 0.17*im;
    innerWire.visible = im > 0;
    innerWire.scale.setScalar(0.55 + 0.45*im);

    // core pulse
    var pulse = reduce ? 2.4 : 2.4 + Math.sin(t*1.4)*0.22 + scrollP*0.5;
    core.scale.set(pulse,pulse,1);
    coreMat.opacity = 0.55 + morph*0.15 + (reduce?0:Math.sin(t*1.4)*0.08);

    // rotation + parallax: sphere spins on y, hexagon turns in-plane; each speed fades with the morph
    if(!reduce){
      morphU.uSpin.value += dt*0.07*(1-morph);
      morphU.uHexRot.value += dt*0.06*morph;
    }
    mx += (tx - mx)*0.05; my += (ty - my)*0.05;
    group.rotation.x = my*0.5*(1-morph*0.5) + scrollP*0.2*(1-morph);
    group.rotation.z = mx*0.12;
    var es = baseScale*(1 - smooth(0,1,exitP)*0.3);
    group.scale.set(es,es,es);
    group.position.y = smooth(0,1,exitP)*1.3;
    camera.position.x = mx*0.6;
    camera.position.y = -my*0.4;
    camera.lookAt(0,0,0);

    renderer.render(scene,camera);
  }
  tick();

  /* ---------- intro: particle peony that blooms, then dissolves into the page ----------
     Stylized take on a blooming-peony clip: ~12k points on a dusk-violet backdrop.
     Assembles from dust (0-1s), then loops bloom -> hold -> close back to a bud, until the visitor
     enters (button, click, scroll, Esc/Enter/Space) -> petals dissolve and the page crossfades in. */
  function initIntro(){
    var root = document.documentElement, el = document.getElementById('intro');
    if(!el || !root.classList.contains('intro-on')) return;
    clearTimeout(window.__introSafety);
    try{ sessionStorage.setItem('fp-intro','1'); }catch(err){}
    var cv = document.getElementById('intro-gl'), r;
    try{ r = new THREE.WebGLRenderer({canvas:cv, alpha:true, antialias:true}); }catch(err){ root.classList.remove('intro-on'); return; }
    r.setClearColor(0x000000, 0);

    var sc = new THREE.Scene(), cam = new THREE.PerspectiveCamera(40, 1, 0.1, 50);
    cam.position.set(0, 0.2, 5.2);
    var flower = new THREE.Group(); sc.add(flower);

    // ---- geometry: petals (3 layers), stamen dome, stem, drifting pollen ----
    var A = [], RND = [], K = [];
    function add(kind, a, b, c, d){ K.push(kind); A.push(a, b, c, d); RND.push(Math.random(), Math.random(), Math.random()); }
    var LAYERS = [{n:6, pts:300}, {n:8, pts:340}, {n:10, pts:380}, {n:12, pts:420}];
    LAYERS.forEach(function(L, layer){
      for(var i=0;i<L.n;i++){
        var phi = i*Math.PI*2/L.n + layer*0.41 + (Math.random()-.5)*0.25;
        for(var j=0;j<L.pts;j++){
          var u = Math.pow(Math.random(), 0.8);
          var v = j < L.pts*0.3 ? (Math.random()<0.5?-1:1)*(0.9+Math.random()*0.1) : Math.random()*2-1;   // 30% trace the outline
          if(j >= L.pts*0.3 && j < L.pts*0.42) u = 0.93 + Math.random()*0.07;                               // and the rounded tip
          add(0, layer, phi, u, v);
        }
      }
    });
    for(var c=0;c<1400;c++) add(1, Math.sqrt(Math.random()), Math.random()*Math.PI*2, Math.random(), 0);
    for(var t=0;t<1800;t++) add(2, Math.random(), Math.random()*Math.PI*2, Math.random(), 0);
    for(var q=0;q<320;q++) add(3, (Math.random()-.5)*7, (Math.random()-.5)*5, (Math.random()-.5)*3, 0);

    var g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(new Float32Array(K.length*3), 3));   // computed in the shader
    g.setAttribute('aA', new THREE.BufferAttribute(new Float32Array(A), 4));
    g.setAttribute('aR', new THREE.BufferAttribute(new Float32Array(RND), 3));
    g.setAttribute('aKind', new THREE.BufferAttribute(new Float32Array(K), 1));

    var U = {
      uTime:{value:0}, uBloom:{value:0}, uAssemble:{value:0}, uOut:{value:0}, uTilt:{value:0.2}, uPix:{value:1}, uSize:{value:0.034},
      cBase:{value:new THREE.Color(tok('--accent-2','#5a2fd0'))}, cMid:{value:new THREE.Color(tok('--accent-soft','#b9a4ff'))},
      cTip:{value:new THREE.Color(tok('--bg-2','#fff'))}, cGold:{value:new THREE.Color(tok('--ember-hot','#ffd27a'))}
    };
    var mat = new THREE.ShaderMaterial({
      uniforms:U, transparent:true, depthWrite:false, depthTest:false, blending:THREE.AdditiveBlending,   // dark backdrop: additive glows
      vertexShader:[
        "attribute vec4 aA; attribute vec3 aR; attribute float aKind;",
        "uniform float uTime,uBloom,uAssemble,uOut,uPix,uSize,uTilt;",
        "uniform vec3 cBase,cMid,cTip,cGold;",
        "varying vec3 vCol; varying float vAlpha;",
        "vec3 petal(vec4 a, out vec3 col, out float open, out float rim){",
        "  float layer=a.x, phi=a.y, u=a.z, v=a.w;",
        "  float d = 0.09*(3.0-layer);",                                   // outer petals open first
        "  open = smoothstep(d, d+0.7, uBloom);",
        "  float jit = sin(phi*7.3 + layer*1.7);",                         // per-petal variation
        "  float len = (0.72 + layer*0.2)*(1.0 + jit*0.08), W = 0.4 + layer*0.09;",
        "  float ue = u*1.1;",
        "  float w = sqrt(max(0.0, 1.0 - pow((ue-0.55)/0.55, 2.0)))*W*(0.75+0.25*open);",   // broad oval, rounded tip
        "  float edge = abs(v);",
        "  rim = max(smoothstep(0.85,1.0,edge), smoothstep(0.92,1.0,u));",   // outline + rounded tip
        "  float ruf = sin(v*10.0 + phi*3.0 + u*6.0 + uTime*0.8)*0.08*u*(0.3+edge);",   // ruffled petal edge
        "  float a0 = 0.1 + layer*0.1 - 0.5*u*u;",                         // bud: upright, tips curl in
        "  float a1 = 0.55 + layer*0.26 + 0.3*u*u + jit*0.12;",           // open: cupped peony, tips fold out
        "  float ang = mix(a0, a1, open) + sin(uTime*0.9 + phi)*0.02;",
        "  float along = u*len;",
        "  float rr = 0.06 + sin(ang)*along, h = cos(ang)*along;",
        "  float cup = v*v*w*mix(0.55, 0.25, open);",                      // edges cup toward the centre
        "  rr += (ruf - cup)*cos(ang); h += (cup - ruf)*sin(ang);",
        "  vec3 rd = vec3(cos(phi),0.0,sin(phi)), td = vec3(-sin(phi),0.0,cos(phi));",
        "  col = mix(cBase, cMid, smoothstep(0.0,0.5,u));",
        "  col = mix(col, cTip, smoothstep(0.45,1.0,u)*0.85 + edge*0.15);",
        "  col *= mix(0.55, 1.0, open);",                                   // the bud is darker, brightens as it opens
        "  return rd*rr + td*v*w + vec3(0.0,h,0.0);",
        "}",
        "void main(){",
        "  vec3 p; vec3 col; float size = 1.0, alpha = 0.7, open = 1.0, rim = 0.0;",
        "  if(aKind < 0.5){ p = petal(aA, col, open, rim); alpha = mix(0.38, 0.9, rim); }",   // dim fill, bright outlines
        "  else if(aKind < 1.5){",                                          // stamens: golden dome that swells
        "    float s = mix(0.45, 1.0, smoothstep(0.3,1.0,uBloom));",
        "    p = vec3(cos(aA.y)*aA.x*0.26, 0.12 + aA.z*0.16*(1.0-aA.x*0.7), sin(aA.y)*aA.x*0.26)*s;",
        "    col = mix(cGold, cTip, aR.x*0.3)*mix(0.4,1.0,uBloom); size = 1.5; alpha = 0.75;",
        "  } else if(aKind < 2.5){",                                        // stem: upright S-curve down out of frame
        "    float t = aA.x;",
        "    float rad = (aR.x < 0.1 ? 0.075 : 0.032*(0.7+0.3*aA.z))*(1.0 - 0.25*t);",   // 10% stray 'fuzz' like the real stem
        "    p = vec3(0.16*sin(t*3.2) - 0.08*t, -3.8*t, 0.05*t) + vec3(cos(aA.y),0.0,sin(aA.y))*rad;",
        "    col = mix(cBase, cMid, 0.2)*0.7; alpha = 0.42; size = 0.9;",   // thin and quiet, like the real stem
        "  } else {",                                                       // pollen drifting upward
        "    p = aA.xyz; p.y = mod(p.y + uTime*0.18 + 2.5, 5.0) - 2.5;",
        "    col = cMid; size = 1.3; alpha = 0.22*(0.5+0.5*sin(uTime*2.0 + aR.x*30.0));",
        "  }",
        "  if(aKind < 1.5){ float c = cos(uTilt), s = sin(uTilt); p = vec3(p.x, p.y*c - p.z*s, p.y*s + p.z*c); }",   // head faces the viewer
        "  float as = smoothstep(aR.z*0.4, aR.z*0.4 + 0.6, uAssemble);",   // gather from scattered dust
        "  vec3 scatter = (aR - 0.5)*vec3(7.0,5.0,4.0);",
        "  if(aKind < 2.5) p = mix(scatter, p, as);",
        "  p += normalize(p + vec3(0.0,0.001,0.0))*uOut*uOut*(1.2 + aR.x*2.4);",   // dissolve outward at the end
        "  vec4 mv = modelViewMatrix*vec4(p,1.0);",
        "  gl_Position = projectionMatrix*mv;",
        "  gl_PointSize = uSize*size*(0.6 + aR.y*0.8)*uPix/(-mv.z);",
        "  vCol = col; vAlpha = alpha*(aKind > 2.5 ? 1.0 : mix(0.25, 1.0, as))*(1.0 - uOut);",
        "}"
      ].join("\n"),
      fragmentShader:[
        "precision mediump float;",
        "varying vec3 vCol; varying float vAlpha;",
        "void main(){",
        "  float d = length(gl_PointCoord - 0.5);",
        "  if(d > 0.5) discard;",
        "  gl_FragColor = vec4(vCol, vAlpha*smoothstep(0.5, 0.0, d));",
        "}"
      ].join("\n")
    });
    var pts = new THREE.Points(g, mat);
    pts.frustumCulled = false;   // positions come from the shader; the buffer is all zeros
    flower.add(pts);

    function size(){
      var w = window.innerWidth, h = window.innerHeight, dpr = Math.min(window.devicePixelRatio||1, 2);
      r.setPixelRatio(dpr); r.setSize(w, h, false);
      cam.aspect = w/h; cam.updateProjectionMatrix();
      U.uPix.value = dpr*(h/2);
      flower.scale.setScalar(0.82*Math.min(1, cam.aspect*1.25));   // a touch smaller; fits portrait phones
    }
    size();
    window.addEventListener('resize', size);

    function ease(x){ x = Math.min(Math.max(x,0),1); return x*x*(3-2*x); }
    var start = performance.now(), outAt = -1, OUT_DUR = 1.0, done = false;
    var CYCLE = 7.0;   // bloom 2.8s, hold 1.6s, close 2.0s, rest as a bud 0.6s
    function bloomAt(t){
      if(t < 0.5) return 0;
      var ph = (t - 0.5) % CYCLE;
      if(ph < 2.8) return ease(ph/2.8);
      if(ph < 4.4) return 1;
      if(ph < 6.4) return 1 - ease((ph - 4.4)/2.0);
      return 0;
    }
    function enter(){ if(outAt < 0) outAt = (performance.now() - start)/1000; }
    function onKey(e){ if(e.key === 'Escape' || e.key === 'Enter' || e.key === ' '){ e.preventDefault(); enter(); } }
    function finish(){
      if(done) return; done = true;
      root.classList.remove('intro-on');
      window.removeEventListener('resize', size);
      window.removeEventListener('keydown', onKey);
      window.removeEventListener('wheel', enter);
      window.removeEventListener('touchmove', enter);
      g.dispose(); mat.dispose(); r.dispose();
      if(r.forceContextLoss) r.forceContextLoss();
    }
    el.querySelector('.intro-skip').addEventListener('click', enter);
    el.addEventListener('click', enter);
    window.addEventListener('keydown', onKey);
    window.addEventListener('wheel', enter, {passive:true});
    window.addEventListener('touchmove', enter, {passive:true});

    function frame(now){
      if(done) return;
      requestAnimationFrame(frame);
      var t = (now - start)/1000;
      U.uTime.value = t;
      U.uAssemble.value = ease(t/1.0);
      var bloom = bloomAt(t);
      U.uBloom.value = bloom;
      if(outAt >= 0){
        var o = (t - outAt)/OUT_DUR;
        U.uOut.value = ease(o);
        el.classList.add('out');
        if(o >= 1){ finish(); return; }
      }
      U.uTilt.value = 0.2 + bloom*0.5;               // the head turns toward the viewer as it opens (3/4 view)
      flower.rotation.y = Math.sin(t*0.35)*0.3;      // gentle sway rather than a spin, so the stem stays put
      flower.position.y = 0.5 + bloom*0.1;
      r.render(sc, cam);
    }
    requestAnimationFrame(frame);
  }

  /* ---------- 3D glass service glyphs ----------
     White frosted extruded layers with a warm rim light, casting soft shadows onto the card.
     They build in from thin outlines when the card scrolls into view, then drift; hover spreads the layers. */
  function initGlyphs(){
    var els = [].slice.call(document.querySelectorAll('.glyph[data-shape]'));
    if(!els.length) return;
    var WHITE = tok('--bg-2','#fff'), RIM = tok('--ember-hot','#ffd27a'), FILL = tok('--accent-soft','#b9a4ff'), SHADOW = tok('--accent-2','#5a2fd0');
    var GLASS = new THREE.Color(WHITE).lerp(new THREE.Color(FILL), 0.3);
    var GLASS_OPACITY = 0.5;   // see-through glass
    var DEPTH = 0.16, TAU = Math.PI*2;

    function ext(shape){
      var g = new THREE.ExtrudeGeometry(shape, {depth:DEPTH, bevelEnabled:true, bevelThickness:0.035, bevelSize:0.03, bevelSegments:4, curveSegments:72});
      g.translate(0,0,-DEPTH/2); return g;
    }
    function arcBand(r0, r1, a0, a1){
      var s = new THREE.Shape(); s.absarc(0,0,r1,a0,a1,false); s.absarc(0,0,r0,a1,a0,true); s.closePath(); return ext(s);
    }
    function poly(n, R, rot){
      var p = []; for(var i=0;i<n;i++){ var a = rot + i*TAU/n; p.push(new THREE.Vector2(Math.cos(a)*R, Math.sin(a)*R)); } return p;
    }
    function frame(n, R, w, rot){   // regular polygon outline of stroke width w
      var Ri = (R*Math.cos(Math.PI/n) - w)/Math.cos(Math.PI/n);
      var s = new THREE.Shape(poly(n,R,rot)); s.holes.push(new THREE.Path(poly(n,Ri,rot).reverse())); return ext(s);
    }
    var UP = Math.PI/2;
    var SHAPES = {
      ring: function(){ return [
        {geo:arcBand(1.08,1.2, 0.35, 0.35+TAU*0.86), z:-0.18, spin:-0.22},
        {geo:arcBand(0.6,0.86, Math.PI*0.55, Math.PI*1.45), x:-0.06, z:0.22, spin:0.32},
        {geo:arcBand(0.6,0.7, -Math.PI*0.35, Math.PI*0.25), x:0.04, z:0.06, spin:0.32}
      ]; },
      triangle: function(){ return [
        {geo:frame(3,1.38,0.17,UP), y:0.04, z:-0.18},
        {geo:frame(3,1.02,0.07,UP), x:-0.12, y:0.02, z:0.04},
        {geo:frame(3,0.7,0.15,UP), x:0.14, y:-0.2, z:0.26}
      ]; },
      diamond: function(){ return [
        {geo:frame(4,1.22,0.17,UP), x:-0.14, y:0.12, z:-0.18},
        {geo:frame(4,0.86,0.14,UP), x:0.22, y:-0.16, z:0.18},
        {geo:frame(4,0.42,0.1,UP), x:0.06, y:0.02, z:0.38}
      ]; }
    };

    var items = [];
    els.forEach(function(el){
      var make = SHAPES[el.getAttribute('data-shape')];
      if(!make) return;
      var cv = document.createElement('canvas'), r;
      try{ r = new THREE.WebGLRenderer({canvas:cv, alpha:true, antialias:true}); }catch(err){ return; }
      el.appendChild(cv); el.classList.add('is-3d');
      r.setClearColor(0x000000, 0);
      r.shadowMap.enabled = true; r.shadowMap.type = THREE.VSMShadowMap;   // VSM = soft, blurred shadow like the reference

      var sc = new THREE.Scene(), cam = new THREE.PerspectiveCamera(27, 1, 0.1, 50);
      cam.position.set(0, 0, 7.2);
      sc.add(new THREE.HemisphereLight(WHITE, new THREE.Color(WHITE).lerp(new THREE.Color(FILL), 0.35), 0.5));   // near-neutral, dimmed fill: no lilac streaks on bevels
      var key = new THREE.DirectionalLight(WHITE, 0.35);
      key.position.set(-1.2, 1.8, 6);   // near-frontal: shadow sits close behind, no 'second copy' key.castShadow = true;
      key.shadow.mapSize.set(1024,1024); key.shadow.bias = -0.0005; key.shadow.radius = 14;
      var sca = key.shadow.camera; sca.left = sca.bottom = -3; sca.right = sca.top = 3; sca.near = 1; sca.far = 15;
      sc.add(key);
      // grazing warm lights pick out the bevels -> golden edges
      var rim = new THREE.PointLight(RIM, 0.35, 9); rim.position.set(2.8, -2.2, 0.6); sc.add(rim);
      var rim2 = new THREE.PointLight(RIM, 0.15, 9); rim2.position.set(-2.6, 2.4, 0.4); sc.add(rim2);
      var floor = new THREE.Mesh(new THREE.PlaneGeometry(16,16), new THREE.ShadowMaterial({color:SHADOW, opacity:0.06}));
      floor.position.z = -0.8; floor.receiveShadow = true; sc.add(floor);

      var holder = new THREE.Group(); sc.add(holder);
      var pieces = make().map(function(p, k){
        var mat = new THREE.MeshStandardMaterial({color:GLASS, roughness:0.65, metalness:0, transparent:true, opacity:0, depthWrite:false});   // matte = no glare
        var mesh = new THREE.Mesh(p.geo, mat); mesh.castShadow = true; holder.add(mesh);
        return {mesh:mesh, x:p.x||0, y:p.y||0, z:p.z||0, spin:p.spin||0, k:k};
      });

      var it = {el:el, r:r, sc:sc, cam:cam, holder:holder, pieces:pieces, build:reduce?1:0, started:reduce, visible:false,
                hover:0, hoverT:0, hx:0, hy:0, thx:0, thy:0};
      var card = el.closest('.card') || el;
      card.addEventListener('pointermove', function(e){
        var b = card.getBoundingClientRect();
        it.thx = (e.clientX-b.left)/b.width - 0.5; it.thy = (e.clientY-b.top)/b.height - 0.5; it.hoverT = 1;
      });
      card.addEventListener('pointerleave', function(){ it.thx = it.thy = 0; it.hoverT = 0; });
      items.push(it);
    });
    if(!items.length) return;

    function size(){
      var dpr = Math.min(window.devicePixelRatio||1, 2);
      items.forEach(function(it){
        var w = it.el.clientWidth, h = it.el.clientHeight;
        if(!w || !h) return;
        it.r.setPixelRatio(dpr); it.r.setSize(w, h, false);
        it.cam.aspect = w/h; it.cam.updateProjectionMatrix();
      });
    }
    size();
    window.addEventListener('resize', size);

    if('IntersectionObserver' in window){
      var gio = new IntersectionObserver(function(es){
        es.forEach(function(e){
          var it = items.filter(function(x){ return x.el === e.target; })[0];
          it.visible = e.isIntersecting;
          if(e.intersectionRatio > 0.35) it.started = true;
        });
      }, {threshold:[0, 0.35]});
      items.forEach(function(it){ gio.observe(it.el); });
    } else {
      items.forEach(function(it){ it.visible = it.started = true; });
    }

    var last = performance.now();
    function easeOut(x){ x = Math.min(Math.max(x,0),1); return 1 - Math.pow(1-x, 3); }
    function loop(now){
      requestAnimationFrame(loop);
      var dt = Math.min((now - last)/1000, 0.05); last = now;
      if(document.hidden) return;
      var t = reduce ? 0 : now/1000;
      items.forEach(function(it, ci){
        if(!it.visible) return;
        if(it.started && it.build < 1) it.build = Math.min(1, it.build + dt/(1.8 + ci*0.15));
        var lk = Math.min(1, dt*6);
        it.hover += (it.hoverT - it.hover)*lk; it.hx += (it.thx - it.hx)*lk; it.hy += (it.thy - it.hy)*lk;
        it.pieces.forEach(function(p){
          var e = easeOut((it.build - p.k*0.12)/0.76);
          var spread = (1 + it.hover*0.8 + Math.sin(t*1.1 + p.k*1.7)*0.12) * e;
          p.mesh.position.set(p.x*spread, p.y*spread, p.z*spread*1.3);
          var s = 0.85 + 0.15*e;
          p.mesh.scale.set(s, s, 0.05 + 0.95*e);          // starts as a flat outline, extrudes as it builds
          p.mesh.rotation.z = -(1-e)*0.8 + t*p.spin;
          p.mesh.material.opacity = GLASS_OPACITY*Math.min(1, e*1.4);
        });
        it.holder.rotation.x = -it.hy*0.6 + Math.sin(t*0.6 + ci)*0.08;
        it.holder.rotation.y = it.hx*0.8 + Math.sin(t*0.45 + ci*1.3)*0.18;
        it.r.render(it.sc, it.cam);
      });
    }
    requestAnimationFrame(loop);
  }
})();
</script>

<script>
  // Studio section numbers: published notes are added to the repo's post count; the other two come
  // straight from Supabase (public rows only), so they move as soon as something changes in Studio.
  const URL_ = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
  const KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;
  async function count(path: string): Promise<number | null> {
    try {
      const r = await fetch(`${URL_}/rest/v1/${path}`, { method: 'HEAD', headers: { apikey: KEY!, Authorization: `Bearer ${KEY}`, Prefer: 'count=exact' } });
      const m = r.headers.get('content-range')?.match(/\/(\d+)$/);
      return m ? +m[1] : null;
    } catch { return null; }
  }
  const set = (name: string, n: number | null) => {
    const e = document.querySelector<HTMLElement>(`[data-stat="${name}"]`);
    if (e && n != null) e.textContent = String(n);
  };
  if (URL_ && KEY) {
    const base = +(document.querySelector<HTMLElement>('[data-stat="posts"]')?.dataset.base ?? 0);
    count('notes?select=id&status=eq.published').then((n) => set('posts', n == null ? null : base + n));
    count('learning?select=id&is_public=eq.true&status=eq.learning').then((n) => set('learning', n));
    count('todos?select=id&is_public=eq.true&status=eq.done').then((n) => set('done', n));
  }
</script>

