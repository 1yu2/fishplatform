---
import { KEEP_DONE_DAYS } from '../../lib/garden';
---
<!--
  Runs in the browser so the Garden stays current without rebuilding:
  - relative dates ("growing for 12 days", "bloomed 2 days ago") and overdue marking
  - [data-rotate] lists: finished items keep their slot for KEEP_DONE_DAYS days, then drop off and the
    next item moves up; only the first [data-max] visible items are shown
  - [data-autoplay] strips slide on their own, pausing while hovered, focused or touched
-->
<script is:inline define:vars={{ KEEP: KEEP_DONE_DAYS }}>
  (function(){
    if(window.__gardenInit) return; window.__gardenInit = true;
    var DAY = 864e5;
    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    function days(iso){ return Math.floor((Date.now() - Date.parse(iso + 'T00:00:00')) / DAY); }

    function run(){
      document.querySelectorAll('[data-item]').forEach(function(card){
        var when = card.querySelector('[data-when]');
        if(when && when.dataset.when){
          var n = Math.max(0, days(when.dataset.when));
          when.textContent = n === 0 ? when.dataset.tpl0 : when.dataset.tpl.replace('{n}', n);
        }
        var due = card.dataset.due;
        if(due && card.dataset.status !== 'done' && days(due) > 0){
          card.classList.add('overdue');
          var d = card.querySelector('.gd-due'); if(d) d.textContent = d.dataset.overdueLabel + ' · ' + d.textContent;
        }
      });

      document.querySelectorAll('[data-rotate]').forEach(function(list){
        var max = +list.dataset.max || 8, shown = 0;
        list.querySelectorAll('[data-item]').forEach(function(card){
          var expired = card.dataset.status === 'done' && card.dataset.done && days(card.dataset.done) > KEEP;
          var hide = expired || shown >= max;
          card.hidden = hide;
          if(!hide) shown++;
        });
        var wrap = list.closest('[data-garden]');
        if(wrap) wrap.classList.toggle('is-empty', shown === 0);
      });

      if(reduce) return;
      document.querySelectorAll('[data-autoplay]').forEach(function(track){
        var paused = false, visible = false, resume;
        function step(){
          if(paused || !visible || document.hidden) return;
          var card = track.querySelector('[data-item]:not([hidden])');
          if(!card) return;
          var gap = parseFloat(getComputedStyle(track).columnGap) || 16;
          var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
          if(atEnd) track.scrollTo({ left: 0, behavior: 'smooth' });
          else track.scrollBy({ left: card.getBoundingClientRect().width + gap, behavior: 'smooth' });
        }
        setInterval(step, 4500);
        function pause(){ paused = true; clearTimeout(resume); }
        function later(ms){ clearTimeout(resume); resume = setTimeout(function(){ paused = false; }, ms); }
        track.addEventListener('pointerenter', pause);
        track.addEventListener('pointerleave', function(){ later(1500); });
        track.addEventListener('focusin', pause);
        track.addEventListener('focusout', function(){ later(1500); });
        track.addEventListener('touchstart', pause, { passive: true });
        track.addEventListener('touchend', function(){ later(6000); }, { passive: true });
        if('IntersectionObserver' in window){
          new IntersectionObserver(function(es){ visible = es[0].isIntersecting; }).observe(track);
        } else visible = true;
      });
    }
    if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
  })();
</script>
