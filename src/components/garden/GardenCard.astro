---
import { useTranslations, htmlLang, type Lang } from '../../i18n/utils';
import { formatStars, gardenPath, itemTitle, type GardenItem, type RepoMeta } from '../../lib/garden';

interface Props {
  item: GardenItem;
  lang: Lang;
  meta?: RepoMeta;
  /** smaller card for strips and sidebars */
  compact?: boolean;
}
const { item, lang, meta, compact = false } = Astro.props;
const t = useTranslations(lang);
const d = item.data;
const title = itemTitle(item, lang);
const iso = (x?: Date) => (x ? x.toISOString().slice(0, 10) : undefined);
const fmt = (x: Date) => new Intl.DateTimeFormat(htmlLang[lang], { month: 'short', day: 'numeric' }).format(x);
const icon = { task: '◇', repo: '⌥', link: '↗' }[d.type];
---
<article
  class:list={['gd-card', `s-${d.status}`, { compact }]}
  data-item
  data-status={d.status}
  data-started={iso(d.started)}
  data-due={iso(d.due)}
  data-done={iso(d.done)}
>
  <a class="gd-hit" href={gardenPath(lang, item.id)} aria-label={title}></a>
  <div class="gd-top">
    <span class="gd-status">{t(`garden.status.${d.status}`)}</span>
    <span class={`gd-prio p${d.priority}`} title={`${t('garden.priority')}: ${t(`garden.p${d.priority}` as 'garden.p1')}`} aria-label={`${t('garden.priority')}: ${t(`garden.p${d.priority}` as 'garden.p1')}`}>
      <i></i><i></i><i></i>
    </span>
  </div>
  <h3 class="gd-title"><span class="gd-icon" aria-hidden="true">{icon}</span>{title}</h3>
  {!compact && meta?.description && <p class="gd-desc" lang="en">{meta.description}</p>}
  <div class="gd-foot">
    <span class="gd-type">{d.type === 'repo' && d.repo ? d.repo : t(`garden.type.${d.type}`)}</span>
    {meta && <span class="gd-stars">★ {formatStars(meta.stars)}</span>}
    {!compact && meta?.language && <span>{meta.language}</span>}
    {d.status !== 'done' && d.due && (
      <span class="gd-due" data-overdue-label={t('garden.overdue')}>{t('garden.due', { date: fmt(d.due) })}</span>
    )}
    <span
      class="gd-when"
      data-when={d.status === 'doing' ? iso(d.started) : d.status === 'done' ? iso(d.done) : undefined}
      data-tpl={d.status === 'doing' ? t('garden.since') : t('garden.doneAgo')}
      data-tpl0={d.status === 'doing' ? t('garden.sinceToday') : t('garden.doneToday')}
    ></span>
  </div>
</article>
