---
import { languages, langs, localePath, useTranslations, type Lang } from '../i18n/utils';
import { SITE } from '../site';

interface Props {
  lang: Lang;
  current?: 'home' | 'projects' | 'blog' | 'learning' | 'about';
  /** this page in each language, for the language menu */
  alternates: Record<Lang, string>;
}
const { lang, current, alternates } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang, '/');

// one list for the desktop row and the mobile menu; `extra` links drop out of the row on mid-width screens
const links = [
  { href: home, label: t('nav.home'), page: 'home' },
  { href: `${home}#about`, label: t('nav.studio'), extra: true },
  { href: `${home}#services`, label: t('nav.services'), extra: true },
  { href: localePath(lang, '/projects/'), label: t('nav.projects'), page: 'projects' },
  { href: localePath(lang, '/blog/'), label: t('nav.blog'), page: 'blog' },
  { href: localePath(lang, '/learning/'), label: t('nav.learning'), page: 'learning' },
  { href: localePath(lang, '/about/'), label: t('nav.about'), page: 'about' },
];
const attrs = (l: (typeof links)[number]) => ({
  href: l.href,
  'aria-current': l.page && l.page === current ? 'page' : undefined,
  ...(l.external ? { target: '_blank', rel: 'noopener' } : {}),
});
---
<header class="nav">
  <div class="nav-inner">
    <a class="brand" href={home}><span class="dot"></span>{SITE.name}</a>
    <nav class="links" aria-label="Primary">
      {links.map((l) => <a class={l.extra ? 'extra' : undefined} {...attrs(l)}>{l.label}</a>)}
    </nav>
    <div class="nav-right">
      <details class="lang-menu">
        <summary aria-label={t('nav.language')}>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M12 3a9 9 0 100 18 9 9 0 000-18zm0 0c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9m0-18c-2.5 2.6-3.7 5.6-3.7 9s1.2 6.4 3.7 9M3.6 9h16.8M3.6 15h16.8"/></svg>
          <span>{languages[lang]}</span>
          <svg class="chev" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M2.5 4.5L6 8l3.5-3.5"/></svg>
        </summary>
        <ul>
          {langs.map((l) => (
            <li>
              <a href={alternates[l]} hreflang={l} lang={l} data-lang={l} aria-current={l === lang ? 'true' : undefined}>{languages[l]}</a>
            </li>
          ))}
        </ul>
      </details>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-menu"
        aria-label={t('nav.menuOpen')} data-open-label={t('nav.menuOpen')} data-close-label={t('nav.menuClose')}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <nav id="nav-menu" class="nav-menu" aria-label={t('nav.menu')} hidden>
    <ul>
      {links.map((l) => <li><a {...attrs(l)}>{l.label}{l.external && <span aria-hidden="true"> ↗</span>}</a></li>)}
    </ul>
  </nav>
</header>

<script is:inline>
  (function(){
    var KEY = 'fp-lang';
    var menu = document.querySelector('.lang-menu');
    // remember the visitor's language; the bare English homepage sends returning ja/zh visitors to theirs
    document.querySelectorAll('.lang-menu a').forEach(function(a){
      a.addEventListener('click', function(){ try{ localStorage.setItem(KEY, a.getAttribute('data-lang')); }catch(e){} });
    });
    try{
      var saved = localStorage.getItem(KEY);
      if(location.pathname === '/' && (saved === 'ja' || saved === 'zh')) location.replace('/' + saved + '/' + location.hash);
    }catch(e){}
    // close the menu on outside click or Escape
    if(menu){
      document.addEventListener('click', function(e){ if(menu.open && !menu.contains(e.target)) menu.open = false; });
      document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && menu.open){ menu.open = false; menu.querySelector('summary').focus(); } });
    }

    // mobile menu (≤860px): toggle button, closes on link / outside click / Escape / widening past the breakpoint
    var btn = document.querySelector('.nav-toggle');
    var panel = document.getElementById('nav-menu');
    if(!btn || !panel) return;
    var root = document.documentElement;
    function setOpen(open, refocus){
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', btn.getAttribute(open ? 'data-close-label' : 'data-open-label'));
      root.classList.toggle('nav-open', open);   // locks page scroll (see styles)
      if(open){ panel.hidden = false; if(menu) menu.open = false; requestAnimationFrame(function(){ panel.classList.add('is-open'); }); }
      else { panel.classList.remove('is-open'); panel.hidden = true; if(refocus) btn.focus(); }
    }
    btn.addEventListener('click', function(){ setOpen(btn.getAttribute('aria-expanded') !== 'true'); });
    panel.addEventListener('click', function(e){ if(e.target.closest('a')) setOpen(false); });
    if(menu) menu.addEventListener('toggle', function(){ if(menu.open && !panel.hidden) setOpen(false); });
    document.addEventListener('click', function(e){ if(!panel.hidden && !panel.contains(e.target) && !btn.contains(e.target)) setOpen(false); });
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && !panel.hidden) setOpen(false, true); });
    var wide = window.matchMedia('(min-width: 861px)');
    (wide.addEventListener ? wide.addEventListener.bind(wide, 'change') : wide.addListener.bind(wide))(function(){ if(wide.matches && !panel.hidden) setOpen(false); });
  })();
</script>

<style is:global>
  /* dropdown surfaces: lilac glass mixed from the theme tokens rather than plain white */
  header.nav{
    --menu-bg:linear-gradient(165deg,
      color-mix(in srgb, var(--accent-soft) 42%, var(--bg-2)),
      color-mix(in srgb, var(--accent-soft) 26%, var(--bg-2)));
    --menu-hover:rgba(124,77,255,.12);
  }
  .nav-right{display:flex; align-items:center; gap:12px}
  .lang-menu{position:relative}
  .lang-menu summary{
    list-style:none; cursor:pointer; user-select:none;
    display:flex; align-items:center; gap:7px;
    font-family:"Space Mono",monospace; font-size:.72rem; letter-spacing:.04em; color:var(--muted);
    border:1px solid var(--line); border-radius:999px; padding:8px 12px; transition:color .2s, border-color .2s;
  }
  .lang-menu summary::-webkit-details-marker{display:none}
  .lang-menu summary:hover, .lang-menu[open] summary{color:var(--fg); border-color:var(--line-2)}
  .lang-menu .chev{transition:transform .2s}
  .lang-menu[open] .chev{transform:rotate(180deg)}
  .lang-menu ul{
    position:absolute; right:0; top:calc(100% + 8px); z-index:30; min-width:140px;
    list-style:none; margin:0; padding:6px;
    background:var(--card-1); background:var(--menu-bg); border:1px solid var(--line-2); border-radius:14px;
    box-shadow:0 18px 40px -18px rgba(60,40,140,.35);
  }
  .lang-menu li a{
    display:block; padding:8px 12px; border-radius:9px; text-decoration:none;
    color:var(--fg); font-size:.85rem; transition:background .15s, color .15s;
  }
  .lang-menu li a:hover{background:var(--menu-hover); color:var(--accent-2)}
  .lang-menu li a[aria-current="true"]{color:var(--accent-2); font-weight:600}
  .lang-menu li a[aria-current="true"]::after{content:"✓"; float:right; color:var(--accent)}
  nav.links a[aria-current="page"]{color:var(--fg); text-decoration:underline; text-decoration-color:var(--accent); text-underline-offset:6px}
  nav.links a, .lang-menu summary{white-space:nowrap}
  /* eight links don't fit beside the brand and menus on mid-width screens: drop the homepage anchors
     and Contact (the CTA button goes to the same place) */
  @media(max-width:1180px){ nav.links{gap:20px} nav.links a.extra{display:none} }

  /* ---------- mobile menu (≤860px, where the row of links is hidden) ---------- */
  .nav-toggle{
    display:none; position:relative; width:40px; height:36px; flex:none; cursor:pointer;
    background:var(--card-1); background:color-mix(in srgb, var(--accent-soft) 28%, var(--bg-2)); border:1px solid var(--line-2); border-radius:999px; padding:0;
    transition:border-color .2s;
  }
  .nav-toggle:hover, .nav-toggle[aria-expanded="true"]{border-color:var(--line-2)}
  .nav-toggle span{
    position:absolute; left:12px; right:12px; height:1.5px; border-radius:2px; background:var(--fg);
    transition:transform .25s cubic-bezier(.2,.7,.2,1), opacity .2s;
  }
  .nav-toggle span:nth-child(1){top:12px}
  .nav-toggle span:nth-child(2){top:17px}
  .nav-toggle span:nth-child(3){top:22px}
  .nav-toggle[aria-expanded="true"] span:nth-child(1){transform:translateY(5px) rotate(45deg)}
  .nav-toggle[aria-expanded="true"] span:nth-child(2){opacity:0}
  .nav-toggle[aria-expanded="true"] span:nth-child(3){transform:translateY(-5px) rotate(-45deg)}
  @media(max-width:860px){ .nav-toggle{display:block} }

  /* keep the bar (brand, language, close button) above the panel's dimming shadow */
  header.nav .nav-inner{position:relative; z-index:1}
  /* the header has backdrop-filter, so the panel is positioned against it rather than the viewport */
  .nav-menu{
    position:absolute; top:100%; left:max(12px, env(safe-area-inset-left,0px)); right:max(12px, env(safe-area-inset-right,0px));
    max-height:calc(100dvh - 90px); overflow-y:auto; overscroll-behavior:contain;
    background:var(--card-1); background:var(--menu-bg); border:1px solid var(--line-2); border-radius:20px; padding:8px;
    box-shadow:0 24px 50px -24px rgba(60,40,140,.4), 0 0 0 100vmax rgba(43,37,69,.16);
  }
  .nav-menu[hidden]{display:none}
  .nav-menu ul{list-style:none; margin:0; padding:0}
  .nav-menu li + li{border-top:1px solid var(--line)}
  .nav-menu a{
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding:14px 16px; min-height:48px; text-decoration:none;
    font-family:"Archivo",sans-serif; font-weight:600; font-size:1.05rem; color:var(--fg);
    border-radius:12px; transition:background .15s, color .15s;
  }
  .nav-menu a:hover{background:var(--menu-hover); color:var(--accent-2)}
  .nav-menu a[aria-current="page"]{color:var(--accent-2)}
  .nav-menu a[aria-current="page"]::after{content:""; width:7px; height:7px; border-radius:50%; background:var(--accent); flex:none}
  .nav-menu a span{color:var(--accent)}
  html.nav-open, html.nav-open body{overflow:hidden}
  @media (prefers-reduced-motion: no-preference){
    .nav-menu{opacity:0; transform:translateY(-6px); transition:opacity .18s ease, transform .22s cubic-bezier(.2,.7,.2,1)}
    .nav-menu.is-open{opacity:1; transform:none}
  }
</style>
