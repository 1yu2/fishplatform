---
import '../../styles/site.css';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { SITE } from '../../site';
import { htmlLang, langs, localePath, localeStaticPaths, useTranslations, type Lang } from '../../i18n/utils';
import { formatDate } from '../../lib/posts';
import { getNow } from '../../lib/projects';

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const alternates = Object.fromEntries(langs.map((l) => [l, localePath(l, '/now/')])) as Record<Lang, string>;

const now = await getNow();
const sections = [
  { key: 'working', title: t('now.working'), items: now.working },
  { key: 'learning', title: t('now.learning'), items: now.learning },
  { key: 'planning', title: t('now.planning'), items: now.planning },
] as const;
---
<Base lang={lang} title={t('meta.now')} description={t('meta.nowDesc')} path="/now/">
  <Nav lang={lang} current="now" alternates={alternates} />

  <main class="wrap now">
    <header class="now-head">
      <div class="eyebrow">{t('now.eyebrow')}</div>
      <h1 class="page-title">{t('now.title')}</h1>
      <p class="page-lead">{t('now.lead')}</p>
      <p class="updated">
        <i class="pulse" aria-hidden="true"></i>
        {t('now.updated', { date: formatDate(now.updated, lang) })}
      </p>
    </header>

    <div class="cols">
      {sections.map((s, i) => (
        <section class={`col col-${s.key}`} aria-labelledby={`now-${s.key}`}>
          <h2 id={`now-${s.key}`}><span class="idx">0{i + 1}</span>{s.title}</h2>
          {s.items.length === 0 && <p class="empty">{t('now.empty')}</p>}
          <ul>
            {s.items.map((item) => {
              const text = item.text[lang] ?? item.text.en;
              const fallback = !item.text[lang] ? htmlLang.en : undefined;
              return (
                <li class={`item st-${item.status}`}>
                  <span class="status"><i class="dot"></i>{t(`now.st.${item.status}`)}</span>
                  {item.link
                    ? <a class="text" href={item.link} target="_blank" rel="noopener" lang={fallback}>{text} <span aria-hidden="true">↗</span></a>
                    : <span class="text" lang={fallback}>{text}</span>}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <p class="about-now"><a href="https://nownownow.com/about" target="_blank" rel="noopener">{t('now.about')} ↗</a></p>

    <footer class="site-foot">
      <span>© 2026 {SITE.name}</span>
      <a href={localePath(lang, '/')}>{t('about.back')}</a>
    </footer>
  </main>
</Base>

<style>
  .now{padding-top:130px}
  .now-head{max-width:760px}
  .updated{
    display:inline-flex; align-items:center; gap:10px; margin:26px 0 0;
    font-family:var(--font-mono); font-size:.74rem; letter-spacing:.04em; color:var(--muted);
    background:var(--bg-2); border:1px solid var(--line); border-radius:999px; padding:7px 14px 7px 12px;
  }
  .pulse{width:8px; height:8px; border-radius:50%; background:var(--st-shipped); box-shadow:0 0 0 0 var(--st-shipped); animation:pulse 2.4s ease-out infinite}
  @keyframes pulse{ 0%{box-shadow:0 0 0 0 rgba(47,158,116,.45)} 80%,100%{box-shadow:0 0 0 9px rgba(47,158,116,0)} }
  @media (prefers-reduced-motion: reduce){ .pulse{animation:none} }

  .cols{display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin-top:50px}
  @media(max-width:900px){ .cols{grid-template-columns:minmax(0,1fr)} }
  .col{
    position:relative; min-width:0; overflow:hidden;
    background:linear-gradient(160deg, var(--card-1), var(--card-2));
    border:1px solid var(--line); border-radius:20px; padding:26px 24px 14px;
  }
  .col::before{content:""; position:absolute; inset:0; pointer-events:none; background:radial-gradient(120% 70% at 50% -10%, rgba(155,107,255,.14), transparent 60%)}
  .col > *{position:relative}
  .col h2{
    display:flex; align-items:baseline; gap:12px; margin:0 0 10px;
    font-family:var(--font-display); font-weight:700; font-size:1.25rem; color:var(--fg-strong);
  }
  .idx{font-family:var(--font-mono); font-weight:400; font-size:.72rem; color:var(--faint)}
  .col ul{list-style:none; margin:0; padding:0}
  .item{display:flex; flex-direction:column; gap:7px; padding:16px 0; border-top:1px solid var(--line)}
  .item:first-child{border-top:0}
  .status{
    display:inline-flex; align-items:center; gap:7px; align-self:flex-start;
    font-family:var(--font-mono); font-size:.64rem; letter-spacing:.08em; text-transform:uppercase; color:var(--faint);
  }
  .dot{display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--st-paused)}
  .st-active .dot{background:var(--st-building); box-shadow:0 0 8px var(--glow)}
  .st-active .status{color:var(--accent-2)}
  .st-next .dot{background:transparent; box-shadow:inset 0 0 0 1.5px var(--st-building)}
  .st-done .dot{background:var(--st-shipped)}
  .st-done .status{color:var(--st-shipped)}
  .text{color:var(--fg); line-height:1.5}
  .st-done .text{color:var(--muted)}
  a.text{text-decoration:none; transition:color .2s}
  a.text:hover{color:var(--accent-2)}
  a.text span{color:var(--accent)}
  .empty{color:var(--muted); font-size:.92rem}
  .about-now{margin:28px 0 0; font-family:var(--font-mono); font-size:.74rem}
  .about-now a{color:var(--muted)}
  .about-now a:hover{color:var(--accent-2)}
</style>
