---
import '../../../styles/site.css';
import '../../../components/garden/garden.css';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import GardenCard from '../../../components/garden/GardenCard.astro';
import GardenScript from '../../../components/garden/GardenScript.astro';
import { SITE } from '../../../site';
import { langs, localePath, localeStaticPaths, useTranslations, type Lang } from '../../../i18n/utils';
import { gardenStatuses, getGarden, repoMetaFor } from '../../../lib/garden';

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const alternates = Object.fromEntries(langs.map((l) => [l, localePath(l, '/garden/')])) as Record<Lang, string>;

const items = await getGarden();
const meta = await repoMetaFor(items);
const types = ['task', 'repo', 'link'] as const;
// the full page keeps everything, including the archive of finished items (newest first)
const groups = gardenStatuses.map((status) => ({
  status,
  items:
    status === 'done'
      ? items.filter((i) => i.data.status === 'done').sort((a, b) => b.data.done!.valueOf() - a.data.done!.valueOf())
      : items.filter((i) => i.data.status === status),
}));
---
<Base lang={lang} title={t('meta.garden')} description={t('meta.gardenDesc')} path="/garden/">
  <Nav lang={lang} current="garden" alternates={alternates} />

  <main class="wrap garden-page">
    <header class="g-head">
      <div class="eyebrow">{t('garden.eyebrow')}</div>
      <h1 class="page-title">{t('garden.title')}</h1>
      <p class="page-lead">{t('garden.lead')}</p>
    </header>

    <div class="g-filter" role="group">
      <button type="button" class="chip" data-type="" aria-pressed="true">{t('garden.all')}</button>
      {types.map((ty) => <button type="button" class="chip" data-type={ty} aria-pressed="false">{t(`garden.type.${ty}`)}</button>)}
    </div>

    {items.length === 0 && <p class="g-empty">{t('garden.empty')}</p>}

    {groups.filter((g) => g.items.length).map((g) => (
      <section class={`g-group g-${g.status}`}>
        <h2 class="g-label"><span>{t(`garden.status.${g.status}`)}</span><span class="g-count">{g.items.length}</span></h2>
        <div class="g-grid">
          {g.items.map((item) => (
            <div class="g-cell" data-type={item.data.type}>
              <GardenCard item={item} lang={lang} meta={meta[item.id]} />
            </div>
          ))}
        </div>
      </section>
    ))}

    <footer class="site-foot">
      <span>© 2026 {SITE.name}</span>
      <a href={localePath(lang, '/')}>{t('about.back')}</a>
    </footer>
  </main>
  <GardenScript />
</Base>

<script is:inline>
  (function(){
    var chips = document.querySelectorAll('.g-filter .chip');
    chips.forEach(function(c){
      c.addEventListener('click', function(){
        var ty = c.getAttribute('data-type');
        chips.forEach(function(x){ x.setAttribute('aria-pressed', String(x === c)); });
        document.querySelectorAll('.g-cell').forEach(function(cell){ cell.hidden = !!ty && cell.getAttribute('data-type') !== ty; });
        document.querySelectorAll('.g-group').forEach(function(g){ g.hidden = !g.querySelector('.g-cell:not([hidden])'); });
      });
    });
  })();
</script>

<style>
  .garden-page{padding-top:130px}
  .g-head{max-width:760px}
  .g-filter{display:flex; flex-wrap:wrap; gap:8px; margin:40px 0 6px}
  .chip{
    font-family:var(--font-mono); font-size:.74rem; letter-spacing:.03em; cursor:pointer;
    color:var(--muted); background:var(--bg-2); border:1px solid var(--line); border-radius:999px; padding:7px 14px;
    transition:color .2s, border-color .2s, background .2s;
  }
  .chip:hover{color:var(--fg); border-color:var(--line-2)}
  .chip[aria-pressed="true"]{color:#fff; background:var(--accent); border-color:var(--accent)}
  .g-empty{color:var(--muted); margin-top:40px}
  .g-group{margin-top:46px}
  .g-group[hidden], .g-cell[hidden]{display:none}
  .g-label{
    display:flex; align-items:center; gap:10px; margin:0 0 18px;
    font-family:var(--font-mono); font-weight:400; font-size:.8rem; letter-spacing:.14em; text-transform:uppercase; color:var(--faint);
  }
  .g-doing .g-label span:first-child{color:var(--accent-2)}
  .g-count{font-size:.7rem; color:var(--muted); border:1px solid var(--line); border-radius:999px; padding:1px 8px; letter-spacing:.04em}
  .g-grid{display:grid; grid-template-columns:repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap:16px}
  .g-cell, .g-cell :global(.gd-card){height:100%}
</style>
