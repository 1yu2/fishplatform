---
import '../../../styles/site.css';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import GardenStrip from '../../../components/garden/GardenStrip.astro';
import { SITE } from '../../../site';
import { languages, langs, localePath, localeStaticPaths, useTranslations, type Lang } from '../../../i18n/utils';
import { formatDate, getPosts, postPath, readingMinutes } from '../../../lib/posts';

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const alternates = Object.fromEntries(langs.map((l) => [l, localePath(l, '/blog/')])) as Record<Lang, string>;

// every post shows in every language's list; ones in another language get a badge
const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort((a, b) => a.localeCompare(b));
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
---
<Base lang={lang} title={t('meta.blog')} description={t('meta.blogDesc')} path="/blog/">
  <Nav lang={lang} current="blog" alternates={alternates} />

  <main class="wrap blog">
    <header class="blog-head">
      <div class="eyebrow">{t('blog.eyebrow')}</div>
      <h1 class="page-title">{t('blog.title')}</h1>
      <p class="page-lead">{t('blog.lead')}</p>
    </header>

    <div class="blog-body">
      <div class="blog-main">
      {tags.length > 0 && (
        <div class="filter" role="group" aria-label={t('blog.filter')}>
          <button type="button" class="chip" data-tag="" aria-pressed="true">{t('blog.all')}</button>
          {tags.map((tag) => <button type="button" class="chip" data-tag={tag} aria-pressed="false">{tag}</button>)}
        </div>
      )}

      {posts.length === 0 && <p class="empty">{t('blog.empty')}</p>}

      {years.map((year) => (
        <section class="year" data-year={year}>
          <h2 class="year-label">{year}</h2>
          <ol class="posts">
            {posts.filter((p) => p.data.date.getFullYear() === year).map((p) => (
              <li class="post" data-tags={p.data.tags.join('|')}>
                <a href={postPath(p)}>
                  <div class="meta">
                    <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang)}</time>
                    <span>· {t('blog.minRead', { n: readingMinutes(p.body) })}</span>
                    {p.data.lang !== lang && <span class="lang-badge">{languages[p.data.lang]}</span>}
                  </div>
                  <h3 lang={p.data.lang}>{p.data.title}</h3>
                  <p lang={p.data.lang}>{p.data.summary}</p>
                  <div class="tags">{p.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
      </div>
      <GardenStrip lang={lang} variant="side" />
    </div>

    <footer class="site-foot">
      <span>© 2026 {SITE.name}</span>
      <a href={localePath(lang, '/')}>{t('about.back')}</a>
    </footer>
  </main>
</Base>

<script is:inline>
  // tag filter: show posts carrying the tag; hide years left empty
  (function(){
    var chips = document.querySelectorAll('.filter .chip');
    chips.forEach(function(c){
      c.addEventListener('click', function(){
        var tag = c.getAttribute('data-tag');
        chips.forEach(function(x){ x.setAttribute('aria-pressed', String(x === c)); });
        document.querySelectorAll('.post').forEach(function(li){
          li.hidden = !!tag && li.getAttribute('data-tags').split('|').indexOf(tag) < 0;
        });
        document.querySelectorAll('.year').forEach(function(y){
          y.hidden = !y.querySelector('.post:not([hidden])');
        });
      });
    });
  })();
</script>

<style>
  .blog{padding-top:130px}
  .blog-head{max-width:760px}
  .blog-body{display:grid; grid-template-columns:minmax(0,1fr) 300px; gap:clamp(30px,5vw,70px); align-items:start}
  .blog-body :global(.gd-side){position:sticky; top:100px; margin-top:44px}
  @media(max-width:1100px){
    .blog-body{grid-template-columns:minmax(0,1fr)}
    .blog-body :global(.gd-side){position:static; order:-1; margin-top:40px}
  }
  .filter{display:flex; flex-wrap:wrap; gap:8px; margin:44px 0 10px}
  .chip{
    font-family:var(--font-mono); font-size:.74rem; letter-spacing:.03em; cursor:pointer;
    color:var(--muted); background:var(--bg-2); border:1px solid var(--line); border-radius:999px; padding:7px 14px;
    transition:color .2s, border-color .2s, background .2s;
  }
  .chip:hover{color:var(--fg); border-color:var(--line-2)}
  .chip[aria-pressed="true"]{color:#fff; background:var(--accent); border-color:var(--accent)}
  .empty{color:var(--muted); margin-top:40px}

  .year{display:grid; grid-template-columns:120px minmax(0,1fr); gap:24px; margin-top:46px}
  .year[hidden], .post[hidden]{display:none}   /* author display rules would otherwise beat [hidden] */
  .year-label{
    font-family:var(--font-mono); font-weight:400; font-size:.85rem; letter-spacing:.12em;
    color:var(--faint); margin:22px 0 0;
  }
  .posts{list-style:none; margin:0; padding:0; border-top:1px solid var(--line)}
  .post{border-bottom:1px solid var(--line)}
  .post a{display:block; padding:22px 4px 24px; text-decoration:none; color:inherit; position:relative}
  .post a::before{
    content:""; position:absolute; left:-14px; top:28px; width:3px; height:0; border-radius:3px;
    background:linear-gradient(var(--accent), var(--glow)); transition:height .3s cubic-bezier(.2,.7,.2,1);
  }
  .post a:hover::before{height:34px}
  .meta{display:flex; flex-wrap:wrap; align-items:center; gap:8px; font-family:var(--font-mono); font-size:.72rem; color:var(--faint)}
  .post h3{
    font-family:var(--font-display); font-weight:700; font-size:clamp(1.2rem, 2.2vw, 1.55rem); line-height:1.25;
    color:var(--fg-strong); margin:10px 0 0; transition:color .2s;
  }
  .post a:hover h3{color:var(--accent-2)}
  .post p{color:var(--muted); margin:8px 0 0; max-width:68ch}
  .tags{display:flex; flex-wrap:wrap; gap:6px; margin-top:14px}
  @media(max-width:700px){
    .year{grid-template-columns:1fr; gap:4px}
    .year-label{margin:0}
    .post a::before{display:none}
  }
</style>
