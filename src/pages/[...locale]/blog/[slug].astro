---
import '../../../styles/site.css';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import { SITE } from '../../../site';
import { langFromParam, languages, langs, localePath, useTranslations, type Lang } from '../../../i18n/utils';
import { formatDate, getPosts, postPath, readingMinutes } from '../../../lib/posts';
import { getProjects, projectPath } from '../../../lib/projects';
import { blogEntries, cachePublic, learningByIds, notePath, publicTodosFor, publishedNotes, renderMarkdown } from '../../../lib/public-data';
import { formatStars, type Learning, type Todo } from '../../../lib/studio-types';

// Rendered on request: a post is either a Markdown file in the repo or a note published from Studio.
export const prerender = false;
const lang = langFromParam(Astro.params.locale);
const slug = Astro.params.slug ?? '';
if (!lang) return Astro.rewrite('/404');
const t = useTranslations(lang);

const files = await getPosts();
const file = files.find((p) => p.id === slug && p.data.lang === lang);
const note = file ? undefined : (await publishedNotes()).find((n) => n.slug === slug && n.lang === lang);
if (!file && !note) return Astro.rewrite('/404');
cachePublic(Astro.response.headers);

// one shape for both sources
const title = file ? file.data.title : note!.title;
const summary = file ? file.data.summary : note!.summary;
const date = file ? file.data.date : new Date(note!.published_at ?? note!.created_at);
const tags = file ? file.data.tags : note!.tags;
const minutes = readingMinutes(file ? file.body : note!.body);
const href = file ? postPath(file) : notePath(note!);
let Content: any = undefined;
let html = '';
let headings: { depth: number; slug: string; text: string }[] = [];
if (file) ({ Content, headings } = await render(file));
else ({ html, headings } = await renderMarkdown(note!.body));
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// translations (repo files share a translationKey); the switcher goes to the translation or that language's blog list
const translations = file?.data.translationKey
  ? files.filter((p) => p.id !== file.id && p.data.translationKey === file.data.translationKey)
  : [];
const alternates = Object.fromEntries(
  langs.map((l) => {
    if (l === lang) return [l, href];
    const tr = translations.find((p) => p.data.lang === l);
    return [l, tr ? postPath(tr) : localePath(l, '/blog/')];
  }),
) as Record<Lang, string>;

// newer / older among all posts in this language
const same = (await blogEntries()).filter((e) => e.lang === lang);
const i = same.findIndex((e) => e.href === href);
const newer = i > 0 ? same[i - 1] : undefined;
const older = i >= 0 && i < same.length - 1 ? same[i + 1] : undefined;

// what a Studio note is linked to (only public learning items / to-dos are visible here)
let relLearning: Learning[] = [];
let relTodos: Todo[] = [];
let relProjects: { href: string; title: string; lang: string }[] = [];
if (note) {
  [relLearning, relTodos] = await Promise.all([learningByIds(note.learning_ids), publicTodosFor({ todoIds: note.todo_ids })]);
  const projects = await getProjects();
  relProjects = note.projects.flatMap((key) => {
    const group = projects.filter((p) => (p.data.translationKey ?? p.id) === key);
    const p = group.find((x) => x.data.lang === lang) ?? group[0];
    return p ? [{ href: projectPath(p), title: p.data.title, lang: p.data.lang }] : [];
  });
}
const hasRelated = relLearning.length + relTodos.length + relProjects.length > 0;

const canonical = file?.data.canonical ?? new URL(href, Astro.site).href;
const origin = file?.data.canonical ? new URL(file.data.canonical).hostname.replace(/^www\./, '') : '';
---
<Base lang={lang} title={`${title} — ${SITE.name}`} description={summary} alternates={alternates}>
  <link slot="head" rel="canonical" href={canonical} />
  <Nav lang={lang} current="blog" alternates={alternates} />

  <main class="wrap">
    <div class="post-grid">
      <article class="post">
        <a class="back" href={localePath(lang, '/blog/')}>{t('blog.back')}</a>
        <header>
          <div class="meta">
            <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
            <span>· {t('blog.minRead', { n: minutes })}</span>
          </div>
          <h1 class="page-title">{title}</h1>
          <p class="page-lead">{summary}</p>
          <div class="tags">{tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          {translations.length > 0 && (
            <p class="also">{t('blog.alsoIn')}: {translations.map((p) => <a href={postPath(p)} lang={p.data.lang}>{languages[p.data.lang]}</a>)}</p>
          )}
        </header>

        <div class="prose">
          {Content ? <Content /> : <Fragment set:html={html} />}
        </div>

        {hasRelated && (
          <section class="related">
            <h2>{t('blog.related')}</h2>
            {relLearning.length > 0 && (
              <div class="rel-group">
                <h3>{t('blog.relLearning')}</h3>
                <div class="rel-cards">
                  {relLearning.map((l) => (
                    <a class="rel-card" href={localePath(lang, `/learning/${l.id}/`)}>
                      <span class="rel-title">{l.kind === 'repo' ? '⌥' : '↗'} {l.title}</span>
                      <span class="rel-meta">
                        {l.repo && <span>{l.repo}</span>}
                        {l.stars != null && <span class="stars">★ {formatStars(l.stars)}</span>}
                        <span>{t(`learning.status.${l.status}`)}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            )}
            {relProjects.length > 0 && (
              <div class="rel-group">
                <h3>{t('blog.relProjects')}</h3>
                <ul class="rel-list">{relProjects.map((p) => <li><a href={p.href} lang={p.lang}>{p.title}</a></li>)}</ul>
              </div>
            )}
            {relTodos.length > 0 && (
              <div class="rel-group">
                <h3>{t('blog.relTodos')}</h3>
                <ul class="rel-list">{relTodos.map((td) => <li class={td.status === 'done' ? 'done' : ''}>{td.status === 'done' ? '✓ ' : '◇ '}{td.title}</li>)}</ul>
              </div>
            )}
          </section>
        )}

        {file?.data.canonical && (
          <p class="origin">{t('blog.originally')} <a href={file.data.canonical} rel="noopener">{origin}</a></p>
        )}

        <nav class="pager" aria-label="Posts">
          {newer ? <a class="newer" href={newer.href}><span>← {t('blog.newer')}</span>{newer.title}</a> : <span />}
          {older ? <a class="older" href={older.href}><span>{t('blog.older')} →</span>{older.title}</a> : <span />}
        </nav>
      </article>

      {toc.length > 1 && (
        <aside class="toc" aria-label={t('blog.toc')}>
          <div class="toc-inner">
            <p class="toc-title">{t('blog.toc')}</p>
            <ol>
              {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </div>
        </aside>
      )}
    </div>

    <footer class="site-foot">
      <span>© 2026 {SITE.name}</span>
      <a href={localePath(lang, '/blog/')}>{t('blog.back')}</a>
    </footer>
  </main>
</Base>

<script is:inline>
  // highlight the section being read in the table of contents
  (function(){
    var links = [].slice.call(document.querySelectorAll('.toc a'));
    if(!links.length || !('IntersectionObserver' in window)) return;
    var map = {};
    links.forEach(function(a){ map[decodeURIComponent(a.getAttribute('href').slice(1))] = a; });
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(!e.isIntersecting) return;
        links.forEach(function(a){ a.removeAttribute('aria-current'); });
        var a = map[e.target.id]; if(a) a.setAttribute('aria-current', 'true');
      });
    }, {rootMargin:'-20% 0px -70% 0px'});
    document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach(function(h){ io.observe(h); });
  })();
</script>

<style>
  .post-grid{display:grid; grid-template-columns:minmax(0,760px) minmax(0,1fr); gap:clamp(30px,6vw,90px); padding-top:120px}
  @media(max-width:1100px){ .post-grid{grid-template-columns:minmax(0,1fr)} .toc{display:none} }
  .back{font-family:var(--font-mono); font-size:.75rem; color:var(--muted); text-decoration:none}
  .back:hover{color:var(--accent-2)}
  header{margin-top:26px}
  .meta{display:flex; gap:8px; font-family:var(--font-mono); font-size:.74rem; color:var(--faint)}
  .post .page-title{font-size:clamp(2rem, 4.6vw, 3.4rem); line-height:1.08; max-width:none}
  .tags{display:flex; flex-wrap:wrap; gap:6px; margin-top:18px}
  .also{font-size:.85rem; color:var(--muted); margin:16px 0 0}
  .also a{color:var(--accent-2); margin-left:6px}

  /* article body: .prose lives in styles/site.css (shared with project pages) */

  .related{margin-top:54px; padding-top:26px; border-top:1px solid var(--line)}
  .related h2{font-family:var(--font-mono); font-weight:400; font-size:.78rem; letter-spacing:.16em; text-transform:uppercase; color:var(--faint); margin:0 0 16px}
  .rel-group + .rel-group{margin-top:20px}
  .rel-group h3{font-size:.85rem; font-weight:600; color:var(--muted); margin:0 0 10px}
  .rel-cards{display:grid; grid-template-columns:repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap:12px}
  .rel-card{display:flex; flex-direction:column; gap:6px; padding:14px 16px; border-radius:14px; text-decoration:none; color:var(--fg-strong);
    background:linear-gradient(160deg, var(--card-1), var(--card-2)); border:1px solid var(--line); transition:border-color .2s, transform .2s}
  .rel-card:hover{border-color:var(--line-2); transform:translateY(-2px)}
  .rel-title{font-weight:600}
  .rel-meta{display:flex; flex-wrap:wrap; gap:10px; font-family:var(--font-mono); font-size:.7rem; color:var(--faint)}
  .rel-meta .stars{color:var(--pollen)}
  .rel-list{margin:0; padding-left:1.1em; color:var(--fg)}
  .rel-list li{margin:4px 0}
  .rel-list li.done{color:var(--muted)}
  .rel-list a{color:var(--accent-2)}
  .origin{margin-top:40px; font-size:.85rem; color:var(--faint); font-family:var(--font-mono)}
  .origin a{color:var(--accent-2)}

  .pager{display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:60px}
  .pager a{
    display:block; padding:18px 20px; border:1px solid var(--line); border-radius:16px; text-decoration:none;
    color:var(--fg-strong); background:linear-gradient(160deg, var(--card-1), var(--card-2)); font-weight:600; line-height:1.35;
    transition:border-color .2s, transform .2s;
  }
  .pager a:hover{border-color:var(--line-2); transform:translateY(-2px)}
  .pager span{display:block; font-family:var(--font-mono); font-weight:400; font-size:.7rem; letter-spacing:.06em; color:var(--faint); margin-bottom:6px}
  .pager .older{text-align:right; grid-column:2}
  @media(max-width:600px){ .pager{grid-template-columns:1fr} .pager .older{grid-column:1; text-align:left} }

  /* ---------- table of contents ---------- */
  .toc{position:relative}
  .toc-inner{position:sticky; top:110px; margin-top:150px; padding-left:18px; border-left:1px solid var(--line)}
  .toc-title{font-family:var(--font-mono); font-size:.7rem; letter-spacing:.16em; text-transform:uppercase; color:var(--faint); margin:0 0 12px}
  .toc ol{list-style:none; margin:0; padding:0}
  .toc li{margin:7px 0; font-size:.86rem; line-height:1.4}
  .toc li.d3{padding-left:14px; font-size:.8rem}
  .toc a{color:var(--muted); text-decoration:none; transition:color .2s}
  .toc a:hover, .toc a[aria-current]{color:var(--accent-2)}
</style>
