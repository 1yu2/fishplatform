---
import '../styles/site.css';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { langs, localePath, useTranslations, type Lang } from '../i18n/utils';

// rendered on request so server-rendered pages (blog, learning) can rewrite to it for unknown slugs
export const prerender = false;
Astro.response.status = 404;
// speak the language of the URL that was asked for (/ja/…, /zh/…, otherwise English)
const lang: Lang = (Astro.url.pathname.match(/^\/(ja|zh)(\/|$)/)?.[1] as Lang | undefined) ?? 'en';
const t = useTranslations(lang);
const alternates = Object.fromEntries(langs.map((l) => [l, localePath(l, '/')])) as Record<Lang, string>;
---
<Base lang={lang} title={`404 — ${t('nf.title')}`} noindex alternates={alternates}>
  <Nav lang={lang} alternates={alternates} />
  <main class="wrap not-found">
    <div class="eyebrow">404</div>
    <h1 class="page-title">{t('nf.title')}</h1>
    <p class="page-lead">{t('nf.lead')}</p>
    <p class="nf-home"><a href={localePath(lang, '/')}>{t('nf.home')}</a></p>
  </main>
</Base>

<style>
  .not-found { padding: 160px 0 120px; text-align: center; }
  .not-found .eyebrow { justify-content: center; }
  .not-found .page-title, .not-found .page-lead { margin-inline: auto; }
  .nf-home { margin-top: 30px; }
  .nf-home a { color: var(--accent-2); }
</style>
