---
// Private dashboard: to-dos, learning list and writing. The page itself is static; everything runs
// in the browser against Supabase, and row-level security only lets the site owner read private
// rows or write anything.
import '../styles/site.css';
import '../studio/studio.css';
import App from '../studio/App';
import { getProjects } from '../lib/projects';

// one entry per project (a project may exist in several languages; prefer the Chinese title)
const all = await getProjects();
const bySlug = new Map<string, { slug: string; title: string }>();
for (const p of all) {
  const slug = p.data.translationKey ?? p.id;
  if (!bySlug.has(slug) || p.data.lang === 'zh') bySlug.set(slug, { slug, title: p.data.title });
}
const projects = [...bySlug.values()];
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title>Studio — Fishbloom</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Hanken+Grotesk:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
</head>
<body class="studio-body">
  <App client:only="preact" projects={projects} />
  <noscript><p style="padding:40px">Studio 需要开启 JavaScript。</p></noscript>
</body>
</html>
