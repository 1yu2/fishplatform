{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about.html",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/now",
      "destination": "/learning/",
      "permanent": true
    },
    {
      "source": "/now/",
      "destination": "/learning/",
      "permanent": true
    },
    {
      "source": "/garden",
      "destination": "/learning/",
      "permanent": true
    },
    {
      "source": "/garden/",
      "destination": "/learning/",
      "permanent": true
    },
    {
      "source": "/garden/:id",
      "destination": "/learning/",
      "permanent": true
    },
    {
      "source": "/ja/now",
      "destination": "/ja/learning/",
      "permanent": true
    },
    {
      "source": "/ja/now/",
      "destination": "/ja/learning/",
      "permanent": true
    },
    {
      "source": "/ja/garden",
      "destination": "/ja/learning/",
      "permanent": true
    },
    {
      "source": "/ja/garden/",
      "destination": "/ja/learning/",
      "permanent": true
    },
    {
      "source": "/ja/garden/:id",
      "destination": "/ja/learning/",
      "permanent": true
    },
    {
      "source": "/zh/now",
      "destination": "/zh/learning/",
      "permanent": true
    },
    {
      "source": "/zh/now/",
      "destination": "/zh/learning/",
      "permanent": true
    },
    {
      "source": "/zh/garden",
      "destination": "/zh/learning/",
      "permanent": true
    },
    {
      "source": "/zh/garden/",
      "destination": "/zh/learning/",
      "permanent": true
    },
    {
      "source": "/zh/garden/:id",
      "destination": "/zh/learning/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "/studio",
      "permanent": false
    }
  ]
}
